{
  "name": "ranger.js",
  "version": "2.0.0",
  "description": "Lightweight, zero-dependency JS library for input range sliders with one or two drag handles.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanaleksandrov/ranger.js.git"
  },
  "homepage": "https://github.com/yanaleksandrov/ranger.js",
  "bugs": "https://github.com/yanaleksandrov/ranger.js/issues",
  "keywords": [
    "range",
    "slider",
    "input",
    "dual-range",
    "vanilla-js"
  ],
  "scripts": {
    "watch": "webpack --mode development --watch",
    "start": "webpack serve --no-client-overlay-warnings",
    "build": "webpack --mode production && prettier --print-width=120 --parser html --write dist/*.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "browserslist": [
    "last 4 versions",
    "> 0.5%",
    "Firefox ESR",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^4.0.0",
    "html-webpack-plugin": "^5.5.0",
    "jsdom": "^24.1.3",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss-loader": "^7.3.3",
    "prettier": "^2.7.1",
    "raw-loader": "^4.0.2",
    "sass": "^1.54.5",
    "sass-loader": "^13.0.2",
    "terser-webpack-plugin": "^5.3.5",
    "vitest": "^1.6.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.10.0"
  }
}
